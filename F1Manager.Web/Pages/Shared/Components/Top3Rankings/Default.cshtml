@model IEnumerable<F1Manager.Web.Models.ResultadoCorrida>

    @{
        var primeiro = Model.FirstOrDefault(r => r.PosicaoFinal == 1);
        var segundo = Model.FirstOrDefault(r => r.PosicaoFinal == 2);
        var terceiro = Model.FirstOrDefault(r => r.PosicaoFinal == 3);
    }

    <div class="podium-card">
        <div class="podium-header">
            <h5 class="podium-title">🏁 Pódio da Corrida</h5>
        </div>
        <div class="podium-body">
            @if (Model != null && Model.Any())
            {
                <div class="podium-container">

                    <!-- 2º Classificado (Esquerda) -->
                    <div class="podium-side-column">
                        @if (segundo != null)
                        {
                            <div class="podium-pilot-name">@segundo.Piloto?.Nome</div>
                            <div class="podium-team-name">
                                @(segundo.Piloto?.Equipa?.Nome ?? "Sem Equipa")
                            </div>
                        }
                        else
                        {
                            <div class="podium-pilot-placeholder">-</div>
                            <div class="podium-team-name">-</div>
                        }
                        <div class="podium-step-2nd">
                            2º
                        </div>
                    </div>

                    <!-- 1º Classificado (Destaque Central) -->
                    <div class="podium-center-column">
                        @if (primeiro != null)
                        {
                            <div class="podium-winner-name">👑 @primeiro.Piloto?.Nome</div>
                            <div class="podium-team-name">
                                @(primeiro.Piloto?.Equipa?.Nome ?? "Sem Equipa")
                            </div>
                        }
                        else
                        {
                            <div class="podium-pilot-placeholder">-</div>
                            <div class="podium-team-name">-</div>
                        }
                        <div class="podium-step-1st">
                            1º
                        </div>
                    </div>

                    <!-- 3º Classificado (Direita) -->
                    <div class="podium-side-column">
                        @if (terceiro != null)
                        {
                            <div class="podium-pilot-name">@terceiro.Piloto?.Nome</div>
                            <div class="podium-team-name">
                                @(terceiro.Piloto?.Equipa?.Nome ?? "Sem Equipa")
                            </div>
                        }
                        else
                        {
                            <div class="podium-pilot-placeholder">-</div>
                            <div class="podium-team-name">-</div>
                        }
                        <div class="podium-step-3rd">
                            3º
                        </div>
                    </div>

                </div>
            }
            else
            {
                <p class="podium-empty-message">Ainda sem resultados oficiais registados nesta corrida.</p>
            }
        </div>
    </div>