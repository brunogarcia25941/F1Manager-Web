@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        // Se o utilizador logado for um Piloto, mostra a opção de aceder ao perfil pessoal
        @if (User.IsInRole("Piloto"))
        {
            <li class="nav-item">
                <a class="nav-link text-white me-2" asp-area="" asp-page="/Pilotos/Perfil">O Meu Perfil</a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Manage/Index" title="Gerir Conta">Olá,
                @User.Identity?.Name!</a>
            </li>
            <li class="nav-item">
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit" class="nav-link btn btn-link text-white">Sair</button>
                </form>
            </li>
        }
    else
        {
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Register">Registar</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
            </li>
        }
    
    
</ul>