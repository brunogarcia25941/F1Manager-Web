<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - F1Manager.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/F1Manager.Web.styles.css" asp-append-version="true" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">F1 Manager</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Equipas/Index">Equipas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Pilotos/Index">Pilotos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Campeonatos/Index">Campeonatos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Corridas/Index">Corridas</a>
                        </li>
                        <!-- Alerta Global de Corrida Ativa -->
                        <li class="nav-item d-none" id="globalLiveRaceBadge">
                            <a class="nav-link text-danger fw-bold" id="globalLiveRaceLink" href="#">
                                <span class="live-indicator"></span> GP EM DIRETO
                            </a>
                        </li>
                    </ul>
                    <div class="position-relative ms-auto me-3 f1-search-container">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-dark text-white border-0">🔍</span>
                            <input type="text" id="globalSearchInput" class="form-control bg-dark text-white border-0"
                                   placeholder="Pesquisar..." autocomplete="off" />
                        </div>
                        <!-- Painel Dropdown flutuante para apresentar os resultados em tempo real -->
                        <div id="globalSearchResults" class="dropdown-menu shadow-lg w-100 mt-1 border-0">
                        </div>
                    </div>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @if (ViewContext.HttpContext.Request.Path.Value?.Contains("/Account/Manage", StringComparison.OrdinalIgnoreCase) == true)
        {
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        <div class="card shadow-sm border-0 p-4 p-md-5 bg-white card-f1">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            @RenderBody()
        }
    </main>

    
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - F1Manager.Web
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
