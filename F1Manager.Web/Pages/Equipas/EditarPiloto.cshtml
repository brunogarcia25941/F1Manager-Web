@page "{id:int}"
@model F1Manager.Web.Pages.Equipas.EditarPilotoModel
@{
    ViewData["Title"] = "Editar Piloto";
}

<div class="edit-piloto-container">
    <div class="profile-details-row">
        <div class="profile-details-col">
            <div class="profile-card">
                <div class="profile-card-header">
                    <h2 class="profile-card-title">✏️ Editar Piloto - @Model.Piloto.Nome</h2>
                </div>
                <div class="profile-card-body">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="error-alert-box" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }

                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Piloto.Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="profile-blocks-grid">
                            <div class="profile-block-col profile-form-group">
                                <label asp-for="Piloto.Nome" class="profile-form-label">Nome do Piloto</label>
                                <input asp-for="Piloto.Nome" class="profile-form-control" />
                                <span asp-validation-for="Piloto.Nome" class="text-danger"></span>
                            </div>
                            <div class="profile-block-col profile-form-group">
                                <label asp-for="Piloto.NumeroCarro" class="profile-form-label">Número do Carro</label>
                                <input asp-for="Piloto.NumeroCarro" type="number" class="profile-form-control" />
                                <span asp-validation-for="Piloto.NumeroCarro" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="profile-blocks-grid">
                            <div class="profile-block-col profile-form-group">
                                <label asp-for="Piloto.Peso" class="profile-form-label">Peso (kg)</label>
                                <input asp-for="Piloto.Peso" type="number" step="0.1" class="profile-form-control" />
                                <span asp-validation-for="Piloto.Peso" class="text-danger"></span>
                            </div>
                            <div class="profile-block-col profile-form-group"></div>
                        </div>

                        <div class="profile-form-group">
                            <label asp-for="Piloto.Biografia" class="profile-form-label">Biografia</label>
                            <textarea asp-for="Piloto.Biografia" class="profile-form-textarea" rows="4"></textarea>
                            <span asp-validation-for="Piloto.Biografia" class="text-danger"></span>
                        </div>

                        <div class="profile-form-group">
                            <label for="FotoUpload" class="profile-form-label">Foto de Perfil</label>
                            @if (!string.IsNullOrEmpty(Model.Piloto.FotoPerfil))
                            {
                                <div class="profile-form-group mt-2 mb-2">
                                     <img src="@Model.Piloto.FotoPerfil" class="profile-preview" alt="Foto Atual" />
                                </div>
                            }
                            <input type="file" id="FotoUpload" name="FotoUpload" class="profile-form-control" accept="image/*" />
                            <small class="profile-form-help">Formatos: JPG, PNG. Tamanho máx: 2MB</small>
                        </div>

                        <div class="form-actions-row">
                            <a href="@Url.Page("/Equipas/Perfil")" class="vincular-btn-secondary">Cancelar</a>
                            <button type="submit" class="vincular-btn-primary">💾 Guardar Alterações</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
