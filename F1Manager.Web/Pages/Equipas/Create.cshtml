@page
@model F1Manager.Web.Pages.Equipas.CreateModel
@{
    ViewData["Title"] = "Nova Equipa";
}

<h1>Adicionar Nova Equipa</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <!-- Mostra erros gerais do modelo -->
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Equipa.Nome" class="control-label">Nome da Equipa</label>
                <input asp-for="Equipa.Nome" class="form-control" />
                <span asp-validation-for="Equipa.Nome" class="text-danger"></span>
            </div>

            <!-- Novo campo: Fabricante de Motor -->
            <div class="form-group mb-3">
                <label asp-for="Equipa.FabricanteMotor" class="control-label">Fabricante de Motor</label>
                <input asp-for="Equipa.FabricanteMotor" class="form-control" />
                <span asp-validation-for="Equipa.FabricanteMotor" class="text-danger"></span>
            </div>

            <!-- Novo campo: País -->
            <div class="form-group mb-3">
                <label asp-for="Equipa.Pais" class="control-label">País</label>
                <input asp-for="Equipa.Pais" class="form-control" />
                <span asp-validation-for="Equipa.Pais" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>