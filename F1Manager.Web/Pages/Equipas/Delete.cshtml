@page
@model F1Manager.Web.Pages.Equipas.DeleteModel
@{
    ViewData["Title"] = "Apagar Equipa";
}

<h1>Apagar Equipa</h1>
<h3>Tens a certeza que queres apagar @Model.Equipa.Nome?</h3>
<form method="post">
    <input type="hidden" asp-for="Equipa.Id" />
    <input type="submit" value="Sim, Apagar" class="btn btn-danger" />
    <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
</form>