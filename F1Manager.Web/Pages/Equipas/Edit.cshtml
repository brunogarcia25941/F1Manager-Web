@page
@model F1Manager.Web.Pages.Equipas.EditModel
@{
    ViewData["Title"] = "Editar Equipa";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 card-f1">
                <div class="card-header bg-dark text-white p-4">
                    <h2 class="h4 mb-0">🔧 Editar Construtor</h2>
                    <small class="text-muted">Altere as informações oficiais da equipa</small>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        <input type="hidden" asp-for="Equipa.Id" />

                        <!-- Nome da Equipa -->
                        <div class="form-group mb-3">
                            <label asp-for="Equipa.Nome" class="control-label fw-bold">Nome da Equipa</label>
                            <input asp-for="Equipa.Nome" class="form-control" placeholder="Ex: Scuderia Ferrari" />
                            <span asp-validation-for="Equipa.Nome" class="text-danger"></span>
                        </div>

                        <!-- Fabricante do Motor -->
                        <div class="form-group mb-3">
                            <label asp-for="Equipa.FabricanteMotor" class="control-label fw-bold">Fabricante do Motor</label>
                            <input asp-for="Equipa.FabricanteMotor" class="form-control" placeholder="Ex: Ferrari" />
                            <span asp-validation-for="Equipa.FabricanteMotor" class="text-danger"></span>
                        </div>

                        <!-- País da Sede -->
                        <div class="form-group mb-3">
                            <label asp-for="Equipa.Pais" class="control-label fw-bold">País da Sede</label>
                            <input asp-for="Equipa.Pais" class="form-control" placeholder="Ex: Itália" />
                            <span asp-validation-for="Equipa.Pais" class="text-danger"></span>
                        </div>

                        <!-- Chefe de Equipa -->
                        <div class="form-group mb-3">
                            <label asp-for="Equipa.ChefeEquipa" class="control-label fw-bold">Chefe de Equipa (Team Principal)</label>
                            <input asp-for="Equipa.ChefeEquipa" class="form-control" placeholder="Ex: Frédéric Vasseur" />
                            <span asp-validation-for="Equipa.ChefeEquipa" class="text-danger"></span>
                        </div>

                        <!-- Ano de Fundação -->
                        <div class="form-group mb-3">
                            <label asp-for="Equipa.AnoFundacao" class="control-label fw-bold">Ano de Fundação</label>
                            <input asp-for="Equipa.AnoFundacao" type="number" class="form-control" placeholder="Ex: 1950" />
                            <span asp-validation-for="Equipa.AnoFundacao" class="text-danger"></span>
                        </div>

                        <!-- Upload do Logótipo com Preview se já existir -->
                        <div class="form-group mb-3">
                            <label asp-for="LogoUpload" class="control-label fw-bold">Logótipo da Equipa</label>
                            <input asp-for="LogoUpload" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="LogoUpload" class="text-danger"></span>
                            @if (!string.IsNullOrEmpty(Model.Equipa.Logotipo))
                            {
                                <div class="mt-3">
                                    <small class="text-muted d-block">Logótipo Atual:</small>
                                    <img src="@Model.Equipa.Logotipo" class="logo-preview" alt="Logótipo atual" />
                                </div>
                            }
                        </div>

                        <!-- História / Descrição -->
                        <div class="form-group mb-4">
                            <label asp-for="Equipa.Historia" class="control-label fw-bold">História / Descrição</label>
                            <textarea asp-for="Equipa.Historia" class="form-control" rows="4" placeholder="Escreva a história da equipa..."></textarea>
                            <span asp-validation-for="Equipa.Historia" class="text-danger"></span>
                        </div>

                        <!-- Botões alinhados -->
                        <div class="d-flex justify-content-between align-items-center">
                            <button type="submit" class="btn btn-f1 w-100 me-2">Guardar Alterações</button>
                            <a asp-page="./Index" class="btn btn-secondary py-2 px-3">Voltar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}