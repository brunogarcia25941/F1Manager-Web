@page
@model F1Manager.Web.Pages.Equipas.EditModel
@{
    ViewData["Title"] = "Editar Equipa";
}

<h1>Editar Equipa</h1>
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Equipa.Id" /> <!-- Essencial para o update -->

    <div class="form-group mb-3">
        <label asp-for="Equipa.Nome" class="control-label"></label>
        <input asp-for="Equipa.Nome" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label asp-for="Equipa.FabricanteMotor" class="control-label"></label>
        <input asp-for="Equipa.FabricanteMotor" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label asp-for="Equipa.Pais" class="control-label"></label>
        <input asp-for="Equipa.Pais" class="form-control" />
    </div>
    <input type="submit" value="Guardar" class="btn btn-primary" />
    <a asp-page="./Index" class="btn btn-secondary">Voltar</a>
</form>