@page
@model F1Manager.Web.Pages.Campeonatos.EditModel
@{
    ViewData["Title"] = "Editar Campeonato";
}

<!-- Contentor centrado com margem vertical -->
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 card-f1">
                <div class="card-header bg-dark text-white p-4">
                    <h2 class="h4 mb-0">🔧 Editar Campeonato</h2>
                    <small class="text-muted">Modifique as informações do campeonato</small>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        <input type="hidden" asp-for="Campeonato.Id" />

                        <!-- Nome do Campeonato -->
                        <div class="form-group mb-3">
                            <label asp-for="Campeonato.Nome" class="control-label fw-bold">Nome do Campeonato</label>
                            <input asp-for="Campeonato.Nome" class="form-control" placeholder="Ex: Fórmula 1 - 2026" />
                            <span asp-validation-for="Campeonato.Nome" class="text-danger"></span>
                        </div>

                        <!-- Ano -->
                        <div class="form-group mb-4">
                            <label asp-for="Campeonato.Ano" class="control-label fw-bold">Ano</label>
                            <input asp-for="Campeonato.Ano" class="form-control" type="number" placeholder="Ex: 2026" />
                            <span asp-validation-for="Campeonato.Ano" class="text-danger"></span>
                        </div>

                        <!-- Botões de Ação -->
                        <div class="d-flex justify-content-between align-items-center">
                            <button type="submit" class="btn btn-f1 w-100 me-2">Guardar Alterações</button>
                            <a asp-page="./Index" class="btn btn-secondary py-2 px-3">Voltar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}