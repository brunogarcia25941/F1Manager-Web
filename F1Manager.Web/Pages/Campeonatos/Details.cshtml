@page "{id:int}"
@model F1Manager.Web.Pages.Campeonatos.DetailsModel
@{
    ViewData["Title"] = "Detalhes do Campeonato";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
        <div>
            <h1 class="display-5 fw-bold">🏆 @Model.Campeonato.Nome</h1>
            <p class="text-muted mb-0">Ano de competição: <strong>@Model.Campeonato.Ano</strong></p>
        </div>
        <div>
            <a asp-page="./Index" class="btn btn-secondary">Voltar para a Lista</a>
            @if (User.IsInRole("Administrador"))
            {
                <a asp-page="./Edit" asp-route-id="@Model.Campeonato.Id" class="btn btn-warning">Editar</a>
            }
        </div>
    </div>

    <div class="row">
        <!-- Coluna da Classificação e Estatísticas -->
        <div class="col-md-7 mb-4">
            <!-- Três blocos de estatísticas superiores em grelha -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border text-center h-100 shadow-sm">
                        <h5 class="text-muted text-uppercase fw-bold mb-1 text-stat-title-sm">🏁 Nº de Corridas</h5>
                        <p class="h3 fw-bold mb-0 text-primary">@Model.Campeonato.Corridas.Count</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border text-center h-100 shadow-sm">
                        <h5 class="text-muted text-uppercase fw-bold mb-1 text-stat-title-sm">🏆 Líder Pilotos</h5>
                        @if (Model.Classificacao.Any())
                        {
                            var lider = Model.Classificacao.First();
                            <p class="h6 fw-bold mb-0 text-truncate text-danger" title="@lider.NomePiloto">@lider.NomePiloto</p>
                            <small class="text-muted">@lider.PontosTotais pts</small>
                        }
                        else
                        {
                            <p class="h6 fw-bold mb-0 text-muted">Sem dados</p>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border text-center h-100 shadow-sm">
                        <h5 class="text-muted text-uppercase fw-bold mb-1 text-stat-title-sm">🏎️ Líder Construtores</h5>
                        @if (Model.ClassificacaoEquipas.Any())
                        {
                            var liderEquipa = Model.ClassificacaoEquipas.First();
                            <p class="h6 fw-bold mb-0 text-truncate text-success" title="@liderEquipa.NomeEquipa">@liderEquipa.NomeEquipa</p>
                            <small class="text-muted">@liderEquipa.PontosTotais pts</small>
                        }
                        else
                        {
                            <p class="h6 fw-bold mb-0 text-muted">Sem dados</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Tabela de Classificação -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h3 class="h5 mb-0" id="standingsTitle">🏆 Classificação Geral de Pilotos</h3>
                    <div class="btn-group">
                        <button id="togglePilotos" onclick="switchStandings('pilotos')"
                                class="btn btn-sm btn-outline-light active">Pilotos</button>
                        <button id="toggleEquipas" onclick="switchStandings('equipas')"
                                class="btn btn-sm btn-outline-light">Equipas</button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <!-- Tabela de Pilotos -->
                    <table class="table table-striped table-hover align-middle mb-0" id="standingsPilotos">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center col-pos">Posição</th>
                                <th>Piloto</th>
                                <th>Equipa</th>
                                <th class="text-center col-points">Pontos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int posP = 1;
                            }
                            @foreach (var p in Model.Classificacao)
                            {
                                <tr>
                                    <td class="text-center col-pos fw-bold">@posP º</td>
                                    <td><strong>@p.NomePiloto</strong></td>
                                    <td>@(string.IsNullOrEmpty(p.NomeEquipa) ? "Sem Equipa" : p.NomeEquipa)</td>
                                    <td class="text-center fw-bold text-primary">@p.PontosTotais</td>
                                </tr>
                                posP++;
                            }
                            @if (!Model.Classificacao.Any())
                            {
                                <tr>
                                    <td colspan="4" class="p-4 text-center text-muted">
                                        Nenhum resultado registado neste campeonato.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Tabela de Equipas -->
                    <table class="table table-striped table-hover align-middle mb-0 d-none" id="standingsEquipas">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center col-pos">Posição</th>
                                <th>Equipa</th>
                                <th class="text-center col-points">Pontos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int posE = 1;
                            }
                            @foreach (var e in Model.ClassificacaoEquipas)
                            {
                                <tr>
                                    <td class="text-center col-pos fw-bold">@posE º</td>
                                    <td><strong>@e.NomeEquipa</strong></td>
                                    <td class="text-center fw-bold text-success">@e.PontosTotais</td>
                                </tr>
                                posE++;
                            }
                            @if (!Model.ClassificacaoEquipas.Any())
                            {
                                <tr>
                                    <td colspan="3" class="p-4 text-center text-muted">
                                        Nenhum resultado registado neste campeonato.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Painel de Destaques / Estatísticas Adicionais -->
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h4 class="h6 mb-0 text-uppercase fw-bold tracking-wider">💡 Destaques Adicionais</h4>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded border h-100 text-center">
                                <h5 class="text-muted text-uppercase fw-bold mb-1 text-stat-title-md">🏆 Piloto com Mais Vitórias</h5>
                                @if (Model.MaisVitorias != null)
                                {
                                    <p class="h5 fw-bold mb-0 text-warning text-truncate" title="@Model.MaisVitorias.NomePiloto">
                                        @Model.MaisVitorias.NomePiloto
                                    </p>
                                    <small class="text-muted">@Model.MaisVitorias.Vitorias vitórias em corridas</small>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Sem dados suficientes</p>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded border h-100 text-center">
                                <h5 class="text-muted text-uppercase fw-bold mb-1 text-stat-title-md">🏎️ Construtor mais Eficiente</h5>
                                @if (Model.EquipaMaisPontos != null)
                                {
                                    <p class="h5 fw-bold mb-0 text-success text-truncate" title="@Model.EquipaMaisPontos.NomeEquipa">
                                        @Model.EquipaMaisPontos.NomeEquipa
                                    </p>
                                    <small class="text-muted">@Model.EquipaMaisPontos.PontosTotais pts (Média: @Model.EquipaMaisPontos.MediaPontos.ToString("0.00") pts/res)</small>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Sem dados suficientes</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Coluna do Calendário de Corridas -->
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h3 class="h5 mb-0">📅 Calendário / Corridas</h3>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-page="/Corridas/Create" asp-route-campeonatoId="@Model.Campeonato.Id"
                           class="btn btn-sm btn-light">Agendar Corrida</a>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model.Campeonato.Corridas != null && Model.Campeonato.Corridas.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var corrida in Model.Campeonato.Corridas.OrderBy(c => c.DataHora))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0 fw-bold">@corrida.NomeGrandePremio</h6>
                                        <small class="text-muted">🏁 @corrida.Circuito</small>
                                        <br />
                                        <small class="text-muted">📅 @corrida.DataHora.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                    <a asp-page="/Corridas/Details" asp-route-id="@corrida.Id"
                                       class="btn btn-sm btn-outline-secondary">Ver Corrida</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            Nenhuma corrida agendada para este campeonato.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function switchStandings(type) {
        const title = document.getElementById('standingsTitle');
        const listPilotos = document.getElementById('standingsPilotos');
        const listEquipas = document.getElementById('standingsEquipas');
        const btnPilotos = document.getElementById('togglePilotos');
        const btnEquipas = document.getElementById('toggleEquipas');

        if (type === 'pilotos') {
            title.innerText = "🏆 Classificação Geral de Pilotos";
            listPilotos.classList.remove('d-none');
            listEquipas.classList.add('d-none');
            btnPilotos.classList.add('active');
            btnEquipas.classList.remove('active');
        } else {
            title.innerText = "🏎️ Classificação Geral de Equipas";
            listPilotos.classList.add('d-none');
            listEquipas.classList.remove('d-none');
            btnPilotos.classList.remove('active');
            btnEquipas.classList.add('active');
        }
    }
</script>