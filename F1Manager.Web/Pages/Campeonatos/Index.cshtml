@page
@model F1Manager.Web.Pages.Campeonatos.IndexModel
@{
    ViewData["Title"] = "Lista de Campeonatos";
}

<div class="container">
    <h1 class="display-4">Campeonatos de F1</h1>

    @if (User.IsInRole("Administrador"))
    {
        <p>
            <a asp-page="Create" class="btn btn-primary">Adicionar Novo Campeonato</a>
        </p>
    }

    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Ano</th>
                <th class="text-center">Nº de Corridas</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Campeonatos)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Ano</td>
                    <td class="text-center fw-bold">@item.Corridas.Count</td>
                    <td>
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalhes /
                            Classificação</a>
                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Apagar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
