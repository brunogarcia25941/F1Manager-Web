@page
@model F1Manager.Web.Pages.Campeonatos.CreateModel
@{
    ViewData["Title"] = "Novo Campeonato";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 card-f1">
                <div class="card-header bg-dark text-white p-4">
                    <h2 class="h4 mb-0">🏆 Adicionar Campeonato</h2>
                    <small class="text-muted">Crie uma nova temporada oficial de Formula 1</small>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <!-- Mostra erros de validação gerais -->
                        <div asp-validation-summary="All" class="text-danger" role="alert"></div>

                        <!-- Nome do Campeonato -->
                        <div class="form-group mb-3">
                            <label asp-for="Campeonato.Nome" class="control-label fw-bold">Nome do Campeonato</label>
                            <input asp-for="Campeonato.Nome" class="form-control"
                                   placeholder="Ex: Fórmula 1 - Época 2026" />
                            <span asp-validation-for="Campeonato.Nome" class="text-danger"></span>
                        </div>

                        <!-- Ano -->
                        <div class="form-group mb-3">
                            <label asp-for="Campeonato.Ano" class="control-label fw-bold">Ano</label>
                            <input asp-for="Campeonato.Ano" class="form-control" type="number"
                                   value="@DateTime.Now.Year" />
                            <span asp-validation-for="Campeonato.Ano" class="text-danger"></span>
                        </div>

                        <!-- Ações do formulário -->
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <input type="submit" value="Criar Campeonato" class="btn btn-f1 w-100 me-2" />
                            <a asp-page="Index" class="btn btn-secondary py-2 px-3">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}