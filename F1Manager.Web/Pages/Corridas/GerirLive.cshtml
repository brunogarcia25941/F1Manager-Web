@page "{id:int}"
@model F1Manager.Web.Pages.Corridas.GerirLiveModel
@{
    ViewData["Title"] = "Simulação da Corrida em Direto";
}

<div class="live-container">
    <!-- Cabeçalho -->
    <div class="live-header">
        <h1 class="live-main-title">🏎️ Simulação em Direto: @Model.Corrida.NomeGrandePremio</h1>
        <p class="live-subtitle">Gestão de ultrapassagens e voltas em tempo real via SignalR.</p>
    </div>

    <!-- 1. PAINEL DE CONFIGURAÇÃO INICIAL (SETUP) -->
    <div id="setupPanel" class="setup-panel-card">
        <div class="setup-header">
            <h3 class="setup-title">Configuração do Grid de Partida</h3>
        </div>
        <div class="setup-body">
            <div class="setup-row">
                <div class="setup-col">
                    <label for="inputTotalVoltas" class="setup-label">Número Total de Voltas:</label>
                    <input type="number" id="inputTotalVoltas" class="setup-input" value="50" min="1" max="100" />
                </div>
            </div>

            <div class="setup-selection-header">
                <h4 class="setup-selection-title">Selecione os Pilotos Participantes:</h4>
                <div class="setup-btn-group">
                    <button type="button" class="setup-btn-outline"
                            onclick="toggleSelectAll(true)">Selecionar Todos</button>
                    <button type="button" class="setup-btn-outline"
                            onclick="toggleSelectAll(false)">Desmarcar Todos</button>
                </div>
            </div>

            <div class="pilot-grid-list">
                @foreach (var p in Model.Pilotos)
                {
                    <div class="pilot-grid-item">
                        <div class="pilot-card">
                            <input class="pilot-checkbox" type="checkbox" value="@p.Id"
                                   id="chkPilot_@p.Id" data-nome="@p.Nome"
                                   data-equipa="@(p.Equipa != null ? p.Equipa.Nome : "Sem Equipa")"
                                   checked />
                            <label class="pilot-label" for="chkPilot_@p.Id">
                                @p.Nome <small class="pilot-subtext">(@(p.Equipa != null ? p.Equipa.Nome : "Sem Equipa"))</small>
                            </label>
                        </div>
                    </div>
                }
            </div>

            <button type="button" class="setup-btn-submit" onclick="iniciarCorrida()">🟢 Iniciar Corrida em Direto</button>
        </div>
    </div>

    <!-- 2. PAINEL DE GESTÃO DA CORRIDA (LIVE) -->
    <div id="livePanel" class="live-panel-card" style="display: none;">
        <div class="live-panel-header">
            <h3 class="live-panel-title">🏁 Corrida a Decorrer</h3>
            <span class="live-panel-badge" id="lapDisplay">Volta 1 de 50</span>
        </div>
        <div class="live-panel-body">
            <!-- Controlos da Volta -->
            <div class="live-controls-container">
                <span class="live-controls-label">Alterar Volta Atual:</span>
                <button type="button" class="live-btn-outline" onclick="alterarVolta(-1)">- 1 Volta</button>
                <button type="button" class="live-btn-outline" onclick="alterarVolta(1)">+ 1 Volta</button>
            </div>

            <!-- Tabela de Classificação Interativa -->
            <div class="live-table-wrapper">
                <table class="live-table">
                    <thead class="live-table-header">
                        <tr>
                            <th class="col-pos">Posição</th>
                            <th class="col-pilot">Piloto</th>
                            <th class="col-team">Equipa</th>
                            <th class="col-overtakes">Ultrapassagens</th>
                            <th class="col-time">Tempo Volta Mais Rápida</th>
                        </tr>
                    </thead>
                    <tbody id="liveTableBody">
                        <!-- Linhas geradas via JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Formulário Invisível para Enviar os Resultados Finais para o Servidor -->
            <form id="formFinal" method="post" class="live-form">
                <div id="hiddenInputsContainer"></div>
                <button type="submit" class="live-btn-submit" onclick="prepararSubmissao(event)">🏁 Finalizar Corrida e Gravar na Base de Dados</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const corridaId = @Model.Corrida.Id;
        let totalVoltas = 50;
        let voltaAtual = 1;
        let listaPilotos = [];

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/raceHub")
            .withAutomaticReconnect()
            .build();

        connection.start()
            .then(() => {
                connection.invoke("GetRaceState", corridaId).then((state) => {
                    if (state && state.iniciada) {
                        carregarEstadoExistente(state);
                    }
                });
            })
            .catch(err => console.error("Erro ao ligar ao SignalR:", err.toString()));

        connection.on("ReceiveRaceUpdateLive", (pilotos) => {
            listaPilotos = pilotos;
            renderizarTabela();
        });

        connection.on("ReceiveLapUpdate", (lap) => {
            voltaAtual = lap;
            document.getElementById("lapDisplay").innerText = `Volta ${voltaAtual} de ${totalVoltas}`;
        });

        function toggleSelectAll(select) {
            document.querySelectorAll(".pilot-checkbox").forEach(chk => chk.checked = select);
        }

        function iniciarCorrida() {
            totalVoltas = parseInt(document.getElementById("inputTotalVoltas").value) || 50;
            const checkboxes = document.querySelectorAll(".pilot-checkbox:checked");

            if (checkboxes.length === 0) {
                alert("Por favor, selecione pelo menos um piloto para participar na corrida.");
                return;
            }

            listaPilotos = [];
            checkboxes.forEach((chk, index) => {
                listaPilotos.push({
                    pilotoId: parseInt(chk.value),
                    nome: chk.getAttribute("data-nome"),
                    equipaNome: chk.getAttribute("data-equipa"),
                    posicaoFinal: index + 1,
                    tempoVoltaRapida: "--:--.---"
                });
            });

            const nomeGP = "@Html.Raw(Model.Corrida.NomeGrandePremio)";

            connection.invoke("StartRace", corridaId, nomeGP, totalVoltas, listaPilotos)
                .then(() => {
                    document.getElementById("setupPanel").style.display = "none";
                    document.getElementById("livePanel").style.display = "block";
                    document.getElementById("lapDisplay").innerText = `Volta ${voltaAtual} de ${totalVoltas}`;
                    renderizarTabela();
                })
                .catch(err => console.error("Erro ao iniciar a corrida no SignalR:", err));
        }

        function carregarEstadoExistente(state) {
            totalVoltas = state.totalVoltas !== undefined ? state.totalVoltas : state.TotalVoltas;
            voltaAtual = state.voltaAtual !== undefined ? state.voltaAtual : state.VoltaAtual;
            listaPilotos = state.pilotos || state.Pilotos;

            document.getElementById("setupPanel").style.display = "none";
            document.getElementById("livePanel").style.display = "block";
            document.getElementById("lapDisplay").innerText = `Volta ${voltaAtual} de ${totalVoltas}`;
            renderizarTabela();
        }

        function renderizarTabela() {
            const tbody = document.getElementById("liveTableBody");
            tbody.innerHTML = "";

            listaPilotos.forEach((p, index) => {
                const pilotoId = p.pilotoId !== undefined ? p.pilotoId : p.PilotoId;
                const nome = p.nome || p.Nome;
                const equipaNome = p.equipaNome || p.EquipaNome;
                const tempoVolta = p.tempoVoltaRapida !== undefined ? p.tempoVoltaRapida : p.TempoVoltaRapida;
                const row = document.createElement("tr");

                const btnSubir = `<button type="button" class="btn-live-action btn-up" onclick="moverPiloto(${pilotoId}, true)" ${index === 0 ? 'disabled' : ''}>▲ Subir</button>`;
                const btnDescer = `<button type="button" class="btn-live-action btn-down" onclick="moverPiloto(${pilotoId}, false)" ${index === listaPilotos.length - 1 ? 'disabled' : ''}>▼ Descer</button>`;

                row.innerHTML = `
                    <td class="row-pos">${index + 1}º</td>
                    <td class="row-pilot-name">${nome}</td>
                    <td class="row-team-name">${equipaNome}</td>
                    <td>
                        <div class="btn-group-live">
                            ${btnSubir}
                            ${btnDescer}
                        </div>
                    </td>
                    <td>
                        <input type="text" class="input-lap-time"
                               value="${tempoVolta !== "--:--.---" ? tempoVolta : ''}" placeholder="--:--.---"
                               onchange="atualizarTempoVolta(${pilotoId}, this.value)" />
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        function moverPiloto(pilotoId, subir) {
            connection.invoke("ChangePosition", corridaId, pilotoId, subir)
                .catch(err => console.error("Erro ao mover piloto:", err));
        }

        function alterarVolta(delta) {
            let novaVolta = voltaAtual + delta;
            if (novaVolta < 1 || novaVolta > totalVoltas) return;

            connection.invoke("UpdateLap", corridaId, novaVolta)
                .catch(err => console.error("Erro ao atualizar a volta:", err));
        }

        function atualizarTempoVolta(pilotoId, tempo) {
            connection.invoke("UpdateFastestLap", corridaId, pilotoId, tempo)
                .catch(err => console.error("Erro ao atualizar tempo da volta rápida:", err));
        }

        function prepararSubmissao(event) {
            event.preventDefault();

            if (!confirm("Tem a certeza que deseja terminar e gravar permanentemente estes resultados na base de dados?")) {
                return;
            }

            const container = document.getElementById("hiddenInputsContainer");
            container.innerHTML = "";

            listaPilotos.forEach((p) => {
                const pilotoId = p.pilotoId !== undefined ? p.pilotoId : p.PilotoId;
                const tempoVolta = p.tempoVoltaRapida !== undefined ? p.tempoVoltaRapida : p.TempoVoltaRapida;
                const inputId = document.createElement("input");
                inputId.type = "hidden";
                inputId.name = "FinalPilotoIds";
                inputId.value = pilotoId;
                container.appendChild(inputId);

                const inputTempo = document.createElement("input");
                inputTempo.type = "hidden";
                inputTempo.name = "FinalTempos";
                inputTempo.value = tempoVolta;
                container.appendChild(inputTempo);
            });

            connection.invoke("EndRace", corridaId)
                .then(() => {
                    document.getElementById("formFinal").submit();
                })
                .catch(err => {
                    console.error("Erro ao encerrar a transmissão live:", err);
                    document.getElementById("formFinal").submit();
                });
        }
    </script>
}