@page
@model F1Manager.Web.Pages.Corridas.DetailsModel
@{
    ViewData["Title"] = "Detalhes da Corrida";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
        <div>
            <h1 class="display-5 fw-bold">🏁 @Model.Corrida.NomeGrandePremio</h1>
            <p class="text-muted mb-0">
                Circuito: <strong>@Model.Corrida.Circuito</strong> | 
                Data: <strong>@Model.Corrida.DataHora.ToString("dd/MM/yyyy HH:mm")</strong> | 
                Campeonato: <strong>@Model.Corrida.Campeonato.Nome</strong>
            </p>
        </div>
        <div>
            <a asp-page="/Campeonatos/Details" asp-route-id="@Model.Corrida.CampeonatoId" class="btn btn-secondary">Voltar para o Campeonato</a>
            <a asp-page="./LiveTiming" asp-route-id="@Model.Corrida.Id" class="btn btn-outline-danger">Ver Live Timing</a>
            @if (User.IsInRole("Administrador"))
            {
                <a asp-page="./Edit" asp-route-id="@Model.Corrida.Id" class="btn btn-warning">Editar Corrida</a>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h3 class="h5 mb-0">🏆 Classificação Oficial da Corrida</h3>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-page="./RegistarResultado" asp-route-id="@Model.Corrida.Id" class="btn btn-sm btn-primary">Registar Novo Resultado</a>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model.Resultados.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width: 80px;">Posição</th>
                                    <th>Piloto</th>
                                    <th class="text-center" style="width: 100px;">Nº Carro</th>
                                    <th>Equipa</th>
                                    <th>Volta Mais Rápida</th>
                                    <th class="text-center" style="width: 100px;">Pontos</th>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <th class="text-center" style="width: 120px;">Ações</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Resultados)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@r.PosicaoFinal º</td>
                                        <td class="fw-bold">@r.Piloto.Nome</td>
                                        <td class="text-center">@r.Piloto.NumeroCarro</td>
                                        <td>@(r.Piloto.Equipa != null ? r.Piloto.Equipa.Nome : "Sem Equipa")</td>
                                        <td>@r.TempoVoltaRapida</td>
                                        <td class="text-center fw-bold text-success">@r.Pontos</td>
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <td class="text-center">
                                                <form method="post" asp-page-handler="DeleteResultado" asp-route-pilotoId="@r.PilotoId" asp-route-id="@Model.Corrida.Id" onsubmit="return confirm('Tem a certeza que deseja remover este resultado?');" style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-danger">Remover</button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            Nenhum resultado oficial foi registado para esta corrida.
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            @await Component.InvokeAsync("Top3Rankings", new { corridaId = Model.Corrida.Id })
        </div>
    </div>
</div>
