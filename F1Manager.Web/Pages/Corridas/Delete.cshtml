@page
@model F1Manager.Web.Pages.Corridas.DeleteModel
@{
    ViewData["Title"] = "Apagar Corrida";
}

<h1>Apagar Corrida</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}

<h3>Tens a certeza que queres apagar @Model.Corrida.NomeGrandePremio?</h3>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="Corrida.Id" />
    
    @if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <input type="submit" value="Sim, Apagar" class="btn btn-danger" />
    }
    <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
</form>
