@page "{id:int}"
@model F1Manager.Web.Pages.Corridas.LiveTimingModel
@{
    ViewData["Title"] = "Live Timing";
}

<div class="container mt-4">
    <h1 class="display-5 fw-bold">🕒 Live Timing</h1>
    <p class="text-muted">Acompanhamento em tempo real dos resultados da corrida.</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="h5 mb-1">@Model.Corrida?.NomeGrandePremio</h3>
                    <p class="mb-0 text-muted">Circuito: <strong>@Model.Corrida?.Circuito</strong></p>
                </div>
                <div>
                    <span id="statusBadge" class="badge bg-success fs-6">Classificação Oficial</span>
                    <span id="liveLapDisplay" class="badge bg-dark fs-6 d-none"></span>
                </div>
            </div>

            <div id="liveTable" class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Posição</th>
                            <th>Piloto</th>
                            <th>Equipa</th>
                            <th>Tempo</th>
                        </tr>
                    </thead>
                    <tbody id="resultsBody">
                        @foreach (var item in Model.Resultados)
                        {
                            <tr>
                                <td>@item.PosicaoFinal</td>
                                <td>@item.Piloto?.Nome</td>
                                <td>@item.Piloto?.Equipa?.Nome</td>
                                <td>@item.TempoVoltaRapida</td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>

        @section Scripts {
            <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
            <script>
                const corridaId = @Model.Corrida?.Id;
                let totalVoltas = 50;

                const connection = new signalR.HubConnectionBuilder()
                .withUrl("/raceHub")
                .withAutomaticReconnect()
                .build();

                // 1. Escuta o arranque de uma simulação
                connection.on("ReceiveRaceStart", (state) => {
                ativarModoLive(state);
                });

                // 2. Escuta a mudança da volta atual
                connection.on("ReceiveLapUpdate", (lap) => {
                const lapDisp = document.getElementById('liveLapDisplay');
                lapDisp.innerText = `Volta ${lap} de ${totalVoltas}`;
                });

                // 3. Escuta a alteração na classificação (ultrapassagens)
                connection.on("ReceiveRaceUpdateLive", (pilotos) => {
                renderizarTabela(pilotos);
                });

                // 4. Escuta o encerramento da corrida em direto
                connection.on("ReceiveRaceEnd", () => {
                const badge = document.getElementById('statusBadge');
                badge.className = "badge bg-warning text-dark fs-6";
                badge.innerText = "Corrida Terminada! A carregar dados oficiais...";

                setTimeout(() => {
                location.reload();
                }, 3000);
                });

                // Efetua a ligação e sincroniza o estado caso a corrida já esteja a decorrer
                connection.start()
                .then(() => {
                connection.invoke("GetRaceState", corridaId).then((state) => {
                // Suporta tanto "iniciada" em camelCase como em PascalCase
                const iniciada = state && (state.iniciada !== undefined ? state.iniciada : state.Iniciada);
                if (iniciada) {
                ativarModoLive(state);
                }
                });
                })
                .catch(err => console.error(err.toString()));

                function ativarModoLive(state) {
                // Suporta ambas as nomenclaturas de serialização de propriedades JSON
                const total = state.totalVoltas !== undefined ? state.totalVoltas : state.TotalVoltas;
                const volta = state.voltaAtual !== undefined ? state.voltaAtual : state.VoltaAtual;
                const pilotos = state.pilotos || state.Pilotos;

                totalVoltas = total;

                const badge = document.getElementById('statusBadge');
                badge.className = "badge bg-danger fs-6";
                badge.innerText = "🔴 EM DIRETO";

                const lapDisp = document.getElementById('liveLapDisplay');
                lapDisp.className = "badge bg-dark fs-6"; // Remove d-none e mostra o indicador de voltas
                lapDisp.innerText = `Volta ${volta} de ${totalVoltas}`;

                renderizarTabela(pilotos);
                }

                function renderizarTabela(pilotos) {
                const tbody = document.getElementById('resultsBody');
                tbody.innerHTML = '';

                pilotos.forEach((item, index) => {
                // Suporta propriedades em PascalCase ou camelCase
                const nome = item.nome || item.Nome;
                const equipaNome = item.equipaNome || item.EquipaNome;
                const tempoVolta = item.tempoVoltaRapida !== undefined ? item.tempoVoltaRapida : item.TempoVoltaRapida;

                const row = document.createElement('tr');
                row.innerHTML = `
                <td class="fw-bold">${index + 1}º</td>
                <td class="fw-bold">${nome}</td>
                <td>${equipaNome}</td>
                <td>${tempoVolta !== "--:--.---" ? tempoVolta : "--:--.---"}</td>
                `;
                tbody.appendChild(row);
                });
                }
            </script>
        }