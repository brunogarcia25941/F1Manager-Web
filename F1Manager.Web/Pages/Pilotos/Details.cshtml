@page "{id:int}"
@model F1Manager.Web.Pages.Pilotos.DetailsModel
@{
    ViewData["Title"] = "Detalhes do Piloto";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 card-f1">
                <div class="card-header bg-dark text-white p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h4 mb-0">🏎️ Perfil do Piloto</h2>
                        <span class="badge bg-danger mt-2">@Model.Piloto.Equipa?.Nome</span>
                    </div>
                    <div class="d-flex gap-2">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <form method="post" asp-page-handler="ToggleFavorito" asp-route-id="@Model.Piloto.Id"
                                  class="m-0">
                                <button type="submit"
                                        class="btn btn-sm @(Model.EFavorito ? "btn-warning text-dark" : "btn-outline-warning")">
                                    ★ @(Model.EFavorito ? "Remover Favorito" : "Marcar Favorito")
                                </button>
                            </form>
                        }
                        <a href="@Model.ReturnUrl" class="btn btn-sm btn-outline-light">Voltar</a>
                    </div>
                </div>
                <div class="card-body p-4 p-md-5">
                    <div class="row align-items-center mb-4">
                        <div class="col-md-4 text-center mb-3 mb-md-0">
                            @if (!string.IsNullOrEmpty(Model.Piloto.FotoPerfil))
                            {
                                <img src="@Model.Piloto.FotoPerfil"
                                     class="img-thumbnail rounded-circle shadow-sm profile-img"
                                     alt="Foto de @Model.Piloto.Nome" />
                            }
                            else
                            {
                                <div
                                    class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto shadow-sm profile-placeholder">
                                    @Model.Piloto.Nome.Substring(0, 1)
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <h3 class="display-6 fw-bold mb-1">@Model.Piloto.Nome</h3>
                            <p class="text-muted mb-2">Número do Carro: <span
                                class="badge bg-dark">#@Model.Piloto.NumeroCarro</span></p>
                                <p class="text-muted mb-0">Nacionalidade da Equipa:
                                    <strong>@Model.Piloto.Equipa?.Pais</strong></p>
                                </div>
                            </div>

                            <hr />

                            <div class="row g-4 mt-2">
                                <!-- Bloco de Estatísticas -->
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded border h-100">
                                        <h4 class="h6 text-muted text-uppercase mb-2">Estatísticas Gerais</h4>
                                        <ul class="list-unstyled mb-0">
                                            <li class="mb-2">🏆 Vitórias em Corridas: <strong
                                                class="text-warning">@Model.NumeroVitorias</strong></li>
                                                <li class="mb-2">⚖️ Peso: <strong>@(Model.Piloto.Peso.HasValue ?
                                                                                                $"{Model.Piloto.Peso} kg" : "Não especificado")</strong></li>
                                                    <li>🏁 Corridas Registadas: <strong>@Model.Piloto.Resultados.Count</strong></li>
                                                </ul>
                                            </div>
                                        </div>

                                        <!-- Bloco de Biografia -->
                                        <div class="col-md-6">
                                            <div class="p-3 bg-light rounded border h-100">
                                                <h4 class="h6 text-muted text-uppercase mb-2">Biografia</h4>
                                                <p class="mb-0 text-secondary stat-text">
                                                    @(string.IsNullOrEmpty(Model.Piloto.Biografia) ? "Este piloto ainda não inseriu uma biografia na sua página de perfil." : Model.Piloto.Biografia)
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>