@page
@model F1Manager.Web.Pages.Pilotos.IndexModel
@{
    ViewData["Title"] = "Pilotos";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h1 class="display-5 fw-bold mb-0 text-dark">👤 Pilotos</h1>
            <p class="text-muted mb-0">Lista oficial de pilotos inscritos na temporada e respetivas equipas.</p>
        </div>
        @if (User.IsInRole("Administrador"))
        {
            <a asp-page="Create" class="btn btn-f1">Adicionar Novo Piloto</a>
        }
    </div>

    @if (Model.Pilotos != null && Model.Pilotos.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-2">
            @foreach (var item in Model.Pilotos)
            {
                <div class="col">
                    <div class="f1-driver-card h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <!-- Foto do Piloto (Esquerda) -->
                                    <div class="f1-driver-photo-container">
                                        @if (!string.IsNullOrEmpty(item.FotoPerfil))
                                        {
                                            <img src="@item.FotoPerfil" alt="Foto de @item.Nome" class="f1-driver-photo-img" />
                                        }
                                        else
                                        {
                                            <div class="f1-driver-photo-placeholder">👤</div>
                                        }
                                    </div>
                                    <!-- Número do Piloto (Direita) -->
                                    <div class="f1-number-badge m-0">
                                        #@item.NumeroCarro
                                    </div>
                                </div>
                                <span class="badge bg-dark text-white f1-team-badge-pill">🏁 Piloto Oficial</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div>
                                    <h3 class="h4 text-dark fw-bold mb-1">@item.Nome</h3>
                                    <p class="text-danger fw-bold mb-0">🏎️ @item.Equipa.Nome</p>
                                </div>
                                <!-- Logótipo da Equipa (Direita) -->
                                <div class="f1-driver-team-logo-container">
                                    @if (!string.IsNullOrEmpty(item.Equipa?.Logotipo))
                                    {
                                        <img src="@item.Equipa.Logotipo" alt="Logótipo de @item.Equipa.Nome"
                                             class="f1-driver-team-logo-img" />
                                    }
                                    else
                                    {
                                        <div class="f1-driver-team-logo-placeholder">🏁</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex gap-2">
                            <a asp-page="./Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-dark flex-grow-1 fw-bold">Ficha do Piloto</a>
                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning fw-bold">Editar</a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger fw-bold">Apagar</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-secondary text-center p-5 mt-4" role="alert">
            <h4 class="alert-heading mb-3">Sem Pilotos Registados</h4>
            <p class="mb-0 text-muted">Nenhum piloto oficial foi encontrado na base de dados neste momento.</p>
        </div>
    }
</div>