@page
@model F1Manager.Web.Pages.Admin.Gerenciar.PilotosModel
@{
    ViewData["Title"] = "Gerir Pilotos";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3">👤 Gerir Pilotos</h1>
                <p class="text-muted">Lista de pilotos registados na plataforma</p>
            </div>
            <a href="@Url.Page("/Admin/Index")" class="btn btn-secondary">← Voltar</a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Nome</th>
                            <th>Número</th>
                            <th>Equipa</th>
                            <th>Corridas</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Pilotos.Any())
                        {
                            @foreach (var piloto in Model.Pilotos)
                            {
                                <tr>
                                    <td><strong>@piloto.Nome</strong></td>
                                    <td><span class="badge bg-dark">#@piloto.NumeroCarro</span></td>
                                    <td>@piloto.Equipa</td>
                                    <td>@piloto.NumeroResultados</td>
                                    <td>
                                        <a href="@Url.Page("/Pilotos/Details", new { id = piloto.Id })" 
                                           class="btn btn-sm btn-info">
                                            👁️ Ver
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Nenhum piloto registado
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
